<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>
        <plugin filename="libgz-sim-diff-drive-system.so" name="gz::sim::systems::DiffDrive">
            <!-- Left Side Driving Wheels -->
            <left_joint>left_wheel_one_joint</left_joint>
            <left_joint>left_wheel_two_joint</left_joint>
            <left_joint>left_wheel_three_joint</left_joint>
            
            <!-- Right Side Driving Wheels -->
            <right_joint>right_wheel_one_joint</right_joint>
            <right_joint>right_wheel_two_joint</right_joint>
            <right_joint>right_wheel_three_joint</right_joint>
            
            <!-- Wheel Geometry Configuration -->
            <wheel_separation>0.35</wheel_separation>
            <wheel_diameter>0.1</wheel_diameter>

            <!-- Limits & Torque Scaling -->
            <max_wheel_torque>200</max_wheel_torque>
            <max_wheel_acceleration>10.0</max_wheel_acceleration>

            <!-- Topic Configurations -->
            <topic>cmd_vel</topic>
            <odom_topic>odom</odom_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

            <!-- Keep TF updates active for Nav2 mapping -->
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>
        </plugin>
    </gazebo>

</robot>
