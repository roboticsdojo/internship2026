<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="gamefield">
    <static>true</static>
    <link name="field_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- VISUAL: full-detail original mesh, exactly as exported from CAD.
           Only used for rendering — never touched by the physics engine. -->
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/gamefield_visual.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.58 1</ambient>
          <diffuse>0.6 0.6 0.63 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- COLLISION: 26 convex hulls generated from the same STL via CoACD
           (convex decomposition). Gazebo's physics engines (DART/ODE/Bullet)
           can only resolve contacts correctly against convex shapes, which is
           the actual cause of the walls/ramps collision bug — each hull below
           is individually convex, so it is not a workaround, it is what the
           mesh collision spec requires. -->

      <collision name="collision_00">
        <geometry>
          <mesh>
            <uri>model://gamefield/meshes/collision/hull_00.obj</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e8</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>
