<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="VisionTree">
  <!-- vision:=true. Launch -> wait for Nav2 -> set the start pose from `start` in regions.yaml (no click).
       Then forever: look at the screen -> waste class -> region N -> LOAD N -> pause -> OFFLOAD N.
       WaitForDetection: the class -> region map is the three numbers below. Change them here, no rebuild.
       A number on the `region` topic still overrides the camera at any time.
       No answer in timeout_s, 15 s (camera node dead, nothing on the screen) -> defaults to PLASTIC (region 3)
       and drives on, instead of waiting for a region number. A number on the `region` topic still
       overrides the camera while it is looking. To change the default, edit the three values in DefaultToPlastic. -->
  <BehaviorTree ID="VisionTree">
    <Sequence name="Mission">
      <WaitForNav2 need_amcl="false"/>
      <SetInitialPose file="{route_file}"/>
      <Repeat num_cycles="-1">
        <Sequence name="OneRegion">
          <Fallback name="WhichRegion">
            <WaitForDetection metal="1" organic="2" plastic="3" timeout_s="15"
                              detected_class="{detected_class}"
                              load_key="{load_key}" offload_key="{offload_key}"/>
            <Sequence name="DefaultToPlastic">   <!-- camera dead / no answer in timeout_s: plastic = region 3 -->
              <SetBlackboard output_key="detected_class" value="plastic"/>
              <SetBlackboard output_key="load_key" value="load_3"/>
              <SetBlackboard output_key="offload_key" value="offload_3"/>
            </Sequence>
          </Fallback>
          <ForceSuccess>
            <Sequence name="Trip">
              <LoadWaypoints file="{route_file}" path_name="{load_key}" goals="{goals}"/>
              <FollowWaypoints goals="{goals}"/>
              <FaceHeading file="{route_file}" path_name="{load_key}"/>   <!-- turn to the recorded load yaw -->
              <Sleep msec="3000"/>   <!-- stands in for loading -->
              <LoadWaypoints file="{route_file}" path_name="{offload_key}" goals="{goals}"/>
              <FollowWaypoints goals="{goals}"/>
              <FaceHeading file="{route_file}" path_name="{offload_key}"/>   <!-- turn to the recorded offload yaw -->
              <!-- If the screen is only visible from home, add the return leg so the next look sees it:
              <LoadWaypoints file="{route_file}" path_name="home" goals="{goals}"/>
              <FollowWaypoints goals="{goals}"/>
              <FaceHeading file="{route_file}" path_name="home"/>
              -->
            </Sequence>
          </ForceSuccess>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>