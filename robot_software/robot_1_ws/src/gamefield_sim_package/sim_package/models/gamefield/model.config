<?xml version="1.0"?>
<model>
  <name>gamefield</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Autogenerated from Gamefield_assembly.stl</name>
  </author>

  <description>
    Static game field for Gazebo Harmonic / ROS 2 Jazzy simulation.
    Visual geometry uses the original CAD-exported mesh (full detail, concave).
    Collision geometry uses 26 convex hull pieces generated from that same
    mesh via convex decomposition (CoACD), so gz-physics (DART) can resolve
    contacts against the walls and interior partitions correctly. The
    original mesh was never collision-safe on its own because Gazebo's
    physics engines only compute correct narrow-phase collision against
    convex shapes -- a concave mesh has to be broken into convex pieces
    first, whether that's done by hand as boxes or, as here, automatically.
  </description>
</model>
