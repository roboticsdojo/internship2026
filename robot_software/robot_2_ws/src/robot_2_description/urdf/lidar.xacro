<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Lidar position, chassis origin at the REAR of the chassis:
       x = chassis_length - distance_from_front -->
  <xacro:property name="lidar_chassis_length" value="0.30"/>
  <xacro:property name="lidar_from_front" value="0.07"/>
  <xacro:property name="lidar_x" value="${lidar_chassis_length - lidar_from_front}"/>
  <xacro:property name="lidar_z" value="0.19"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_length" value="0.055"/>

  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder length="${lidar_length}" radius="${lidar_radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="${lidar_length}" radius="${lidar_radius}"/>
      </geometry>
      <material name="black"/>
    </collision>
    <xacro:inertial_cylinder mass="0.1" radius="${lidar_radius}" length="${lidar_length}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <gazebo reference="laser_frame">
    <sensor name="laser" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <topic>/robot_2/scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>
    </sensor>
  </gazebo>

</robot>