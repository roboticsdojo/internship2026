<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="gamefield">

    <!-- These must be explicit: once ANY <plugin> is added to a world,
         gz-sim stops silently loading its implicit default plugin set.
         Physics/UserCommands/SceneBroadcaster happened to already work
         because no plugin was declared at all before now (pure implicit
         defaults) - but that implicit set never includes Sensors, which
         is required for any rendering-based sensor (gpu_lidar, camera,
         depth camera, etc.) to actually produce data. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://gamefield</uri>
      <pose>0 0 0 0 0 4.7124</pose>
    </include>

  </world>
</sdf>